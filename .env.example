# Leave DATABASE_URL empty to use local PGlite at .data/hireflow.db (₹0).
# Example Neon: postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL=

BETTER_AUTH_SECRET=replace-with-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional Google OAuth (never enable without approval)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional transactional email (unset = log-only; in-app notifications still work)
RESEND_API_KEY=

# Local uploads (Phase 1). First cloud store is R2 — do not provision without approval.
UPLOAD_DIR=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# AI — public SaaS off unless an approved privacy-safe provider/BYOK is enabled
AI_EXTERNAL_ENABLED=false
PAID_PROVIDERS_ENABLED=false
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Comma-separated. Required for POST /v1/admin/jobs/* . Never infer admin from a request body.
ADMIN_EMAILS=
ADMIN_USER_IDS=
