{
  "name": "hireflow",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@hireflow/web --filter=@hireflow/marketing --filter=@hireflow/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:web": "pnpm --filter @hireflow/web dev",
    "dev:api": "pnpm --filter @hireflow/api dev",
    "dev:marketing": "pnpm --filter @hireflow/marketing dev"
  },
  "devDependencies": {
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  }
}
